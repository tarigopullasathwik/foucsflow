# ============================================================
# FocusFlow Backend — environment options
# Copy this file to ".env" and fill in only what you have.
# The app runs 100% fine with EVERYTHING commented out
# (SQLite DB, local AI rules engine, console email mode).
# ============================================================

# --- Server ---
#PORT=5000
#DEBUG=True

# --- Real AI Coach (Google Gemini) ---
# Uncomment and paste a key from https://aistudio.google.com/app/apikey
# to switch the coach from the local rules engine to a live Gemini model.
#GEMINI_API_KEY=

# --- Firebase (optional cloud DB + Google OAuth on the frontend) ---
# Path to your Firebase service-account JSON key file.
#FIREBASE_SERVICE_ACCOUNT=
#USE_LOCAL_DB=true

# --- Real email/password auth tuning ---
#MAX_LOGIN_ATTEMPTS=5
#LOCKOUT_MINUTES=15
#SESSION_HOURS=24

# --- Email delivery ---
# "console" = render emails in the backend terminal + store in DB (default, no setup).
# "smtp"    = deliver real emails through the SMTP_* settings below.
#EMAIL_MODE=console
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=youraddress@gmail.com
#SMTP_PASSWORD=your_app_password
#EMAIL_FROM="FocusFlow AI <noreply@focusflow.ai>"
#APP_URL=http://localhost:5173

# --- Google Calendar (optional) ---
#GOOGLE_CALENDAR_CLIENT_ID=
#GOOGLE_CALENDAR_CLIENT_SECRET=
