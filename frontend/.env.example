# ============================================================
# FocusFlow Frontend — environment options
# Copy this file to ".env" and fill in your own values.
#
# NOTE: Vite inlines every VITE_* variable into the built JS
# bundle, so these are PUBLIC values visible to anyone who opens
# the site. That is normal and safe for Firebase web config.
# Never put a service-account key or any real secret here.
# ============================================================

# --- Backend API ---
VITE_API_URL=http://localhost:5000

# --- Firebase (optional) ---
# Leave these as-is to run without Firebase: the app falls back to
# the Flask backend's own server-verified email/password auth.
# To enable Firebase Auth (incl. Google sign-in), paste the values
# from Firebase console -> Project settings -> Your apps -> SDK setup,
# then enable Email/Password and Google under Authentication ->
# Sign-in method.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
